# Microsoft 365 / Entra ID – Client Credentials Flow
# App registracija: https://entra.microsoft.com → App registrations
M365_CLIENT_ID=your_client_id
M365_CLIENT_SECRET=your_client_secret
M365_TENANT_ID=your_tenant_id

# Adresa pošiljatelja (mora biti korisnik u tvom tenantu; aplikacija mora imati Mail.Send i admin pristanak)
M365_FROM_EMAIL=servis@tvoja-domena.hr

# Primatelj servisnih zahtjeva (reklamacije)
TO_EMAIL=servis@armal.hr

# Dozvoljeni origin za CORS (npr. https://tvoja-stranica.railway.app)
FRONTEND_ORIGIN=

# Railway postavlja PORT automatski
PORT=3001
