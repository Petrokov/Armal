# Kopiraj u .env i popuni vrijednosti.

# Google Maps JavaScript API ključ (za PartnerMap na stranici O nama)
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# URL backenda za servisnu formu (lokalno: http://localhost:3001, production: https://tvoj-servis-api.railway.app)
VITE_API_URL=http://localhost:3001

# Dozvoljene domene za servis API. Odvoji zarezom ako ih ima vise.
FRONTEND_ORIGIN=https://www.armal.hr,https://armal.hr

# Servis API rate limit po IP adresi.
SERVICE_RATE_WINDOW_MS=900000
SERVICE_RATE_MAX=5
TRUST_PROXY_HOPS=1

# Microsoft 365 Graph slanje maila.
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_TENANT_ID=
M365_FROM_EMAIL=
TO_EMAIL=servis@armal.hr
